[Unit]
Description=DDMart Native C++ Marketplace Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ddmart
ExecStart=/opt/ddmart/bin/ddmart
Restart=always
RestartSec=5s
Environment=PORT=8080
Environment=HOST=0.0.0.0
Environment=DB_PATH=/opt/ddmart/data/ddmart.db
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
